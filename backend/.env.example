# Supabase project credentials (Project Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Use the SERVICE ROLE key here (not the anon/public key) - this backend
# runs its own auth and needs full DB access from the server. NEVER put
# the service_role key in frontend code or commit it to a public repo.
SUPABASE_KEY=your_service_role_key

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - your frontend URL(s), comma separated
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8501
